{
  "all_good": {
    "strict-transport-security": "max-age=63072000; includeSubDomains; preload",
    "content-security-policy": "default-src 'self'; img-src 'self' data: cdn.example.test",
    "x-content-type-options": "nosniff",
    "referrer-policy": "strict-origin-when-cross-origin",
    "x-frame-options": "DENY",
    "set-cookie": "sessionId=abc; Path=/; Secure; HttpOnly; SameSite=Lax; Expires=Wed, 21 Oct 2026 07:28:00 GMT"
  },
  "none_sent": {},
  "weak_everything": {
    "strict-transport-security": "max-age=86400",
    "content-security-policy": "default-src *; script-src 'unsafe-inline' 'unsafe-eval'",
    "x-content-type-options": "charsetcheck",
    "referrer-policy": "unsafe-url",
    "x-frame-options": "SAMEORIGIN",
    "set-cookie": "pref=xyz"
  },
  "report_only_csp": {
    "content-security-policy-report-only": "default-src 'self'; report-uri /csp-report",
    "x-content-type-options": "nosniff",
    "referrer-policy": "same-origin"
  },
  "frame_ancestors_instead": {
    "content-security-policy": "frame-ancestors 'self'; report-uri /csp",
    "x-content-type-options": "nosniff"
  },
  "multiple_cookies": {
    "set-cookie": "a=1; Secure; HttpOnly; SameSite=Strict; Expires=Wed, 21 Oct 2026 07:28:00 GMT, b=2; Secure; SameSite=Strict, c=3; SameSite=Lax; Secure; Expires=Thu, 22 Oct 2026 07:28:00 GMT"
  },
  "mixed_flags": {
    "set-cookie": "a=1; Secure; HttpOnly; SameSite=Strict, b=2"
  }
}
